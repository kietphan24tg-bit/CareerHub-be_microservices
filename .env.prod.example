# Copy this file to .env.prod (or load it another way) before running:
#   docker compose -f docker-compose.prod.yml pull
#   pnpm prisma:migrate:deploy:all
#   docker compose -f docker-compose.prod.yml up -d
#
# Production should normally pin IMAGE_TAG to a short commit SHA instead of latest.

# -------------------------------------------------------------------
# Release selection
# -------------------------------------------------------------------
IMAGE_TAG=latest

# -------------------------------------------------------------------
# Shared runtime settings
# -------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
LOG_PRETTY=false
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
HEALTH_ENABLED=true
METRICS_ENABLED=true
HTTP_LOG_ENABLED=true

# -------------------------------------------------------------------
# Shared broker settings
# BROKER_URL must use amqps:// in production.
# -------------------------------------------------------------------
BROKER_URL=amqps://<user>:<password>@<cloudamqp-host>/<vhost>
BROKER_EXCHANGE_PREFIX=careerhub.
BROKER_QUEUE_PREFIX=careerhub.
BROKER_DEAD_LETTER_PREFIX=dlq
BROKER_DEAD_LETTER_ENABLED=true
BROKER_DURABLE=true
BROKER_PREFETCH_COUNT=10

# Optional observability scrape config for CloudAMQP
CLOUDAMQP_PROMETHEUS_SCHEME=https
CLOUDAMQP_PROMETHEUS_PATH=/metrics/detailed
CLOUDAMQP_PROMETHEUS_TARGET=<cloudamqp-metrics-host>
CLOUDAMQP_PROMETHEUS_USERNAME=<cloudamqp-prometheus-username>
CLOUDAMQP_PROMETHEUS_PASSWORD=<cloudamqp-prometheus-password>

# -------------------------------------------------------------------
# Gateway
# -------------------------------------------------------------------
GATEWAY_HOST_PORT=3000
APP_BASE_URL=https://api.example.com
AUTH_REFRESH_COOKIE_DOMAIN=.example.com
CORS_ORIGIN=https://app.example.com
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_SECURE=true
GRPC_APPLICATION_URL=application-service:50055
GRPC_CANDIDATE_URL=candidate-service:50052
GRPC_COMMUNICATION_URL=communication-service:50056
GRPC_EMPLOYER_URL=employer-service:50053
GRPC_IAM_URL=iam-service:50051
GRPC_JOB_URL=job-service:50054
JWT_SECRET=<shared-jwt-secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RESUME_PRINT_BASE_URL=https://api.example.com/resumes
THROTTLE_MEDIUM_LIMIT=100
THROTTLE_MEDIUM_TTL_MS=60000
THROTTLE_SHORT_LIMIT=10
THROTTLE_SHORT_TTL_MS=1000

# -------------------------------------------------------------------
# IAM service
# -------------------------------------------------------------------
IAM_DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require
IAM_DIRECT_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require
IAM_GRPC_BIND_URL=0.0.0.0:50051
IAM_MAIL_FROM_ADDRESS=noreply@example.com
IAM_MAIL_FROM_NAME=CareerHub
IAM_MAIL_HOST=smtp.example.com
IAM_MAIL_PASSWORD=<smtp-password>
IAM_MAIL_PORT=587
IAM_MAIL_SECURE=false
IAM_MAIL_USER=<smtp-user>
PASSWORD_RESET_SECRET=<password-reset-secret>
PASSWORD_RESET_TOKEN_TTL_MS=900000
PASSWORD_RESET_MAIL_CLAIM_TIMEOUT_MS=60000
PASSWORD_RESET_MAIL_MAX_RETRIES=3
RESET_PASSWORD_URL_BASE=https://app.example.com/reset-password
IAM_OUTBOX_BACKLOG_INTERVAL_MS=30000
IAM_OUTBOX_BATCH_SIZE=20
IAM_OUTBOX_CLEANUP_BATCH_SIZE=100
IAM_OUTBOX_CLEANUP_ENABLED=true
IAM_OUTBOX_CLEANUP_INTERVAL_MS=60000
IAM_OUTBOX_FAILED_RETENTION_MS=2592000000
IAM_OUTBOX_MAX_RETRY_COUNT=5
IAM_OUTBOX_POLL_INTERVAL_MS=5000
IAM_OUTBOX_PROCESSED_RETENTION_MS=604800000
IAM_OUTBOX_PUBLISH_CONCURRENCY=5
IAM_OUTBOX_PUBLISH_ENABLED=true
IAM_OUTBOX_RETRY_DELAY_MS=30000
IAM_OUTBOX_STALE_PROCESSING_TIMEOUT_MS=60000

# -------------------------------------------------------------------
# Candidate service
# -------------------------------------------------------------------
CANDIDATE_DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require
CANDIDATE_DIRECT_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require
CANDIDATE_GRPC_BIND_URL=0.0.0.0:50052

# -------------------------------------------------------------------
# Employer service
# -------------------------------------------------------------------
EMPLOYER_DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require
EMPLOYER_DIRECT_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require
EMPLOYER_GRPC_BIND_URL=0.0.0.0:50053

# -------------------------------------------------------------------
# Job service
# -------------------------------------------------------------------
JOB_DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require
JOB_DIRECT_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require
JOB_GRPC_BIND_URL=0.0.0.0:50054
MEILISEARCH_HOST=https://<project>.meilisearch.io
MEILISEARCH_API_KEY=<meilisearch-api-key>
JOB_OUTBOX_BACKLOG_INTERVAL_MS=30000
JOB_OUTBOX_BATCH_SIZE=20
JOB_OUTBOX_CLEANUP_BATCH_SIZE=100
JOB_OUTBOX_CLEANUP_ENABLED=true
JOB_OUTBOX_CLEANUP_INTERVAL_MS=60000
JOB_OUTBOX_MAX_RETRY_COUNT=5
JOB_OUTBOX_POLL_INTERVAL_MS=5000
JOB_OUTBOX_PROCESSED_RETENTION_MS=604800000
JOB_OUTBOX_PUBLISH_ENABLED=true
JOB_OUTBOX_RETRY_DELAY_MS=30000
JOB_OUTBOX_STALE_PROCESSING_TIMEOUT_MS=60000
REDIS_URL=redis://<redis-host>:6379
REDIS_SEARCH_CACHE_TTL_S=30
REDIS_SLUG_CACHE_TTL_S=300

# -------------------------------------------------------------------
# Application service
# -------------------------------------------------------------------
APPLICATION_APP_BASE_URL=https://api.example.com
APPLICATION_DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require
APPLICATION_DIRECT_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require
APPLICATION_GRPC_BIND_URL=0.0.0.0:50055
APPLICATION_GRPC_JOB_URL=job-service:50054
APPLICATION_OUTBOX_BACKLOG_INTERVAL_MS=30000
APPLICATION_OUTBOX_BATCH_SIZE=20
APPLICATION_OUTBOX_CLEANUP_BATCH_SIZE=100
APPLICATION_OUTBOX_CLEANUP_ENABLED=true
APPLICATION_OUTBOX_CLEANUP_INTERVAL_MS=60000
APPLICATION_OUTBOX_FAILED_RETENTION_MS=2592000000
APPLICATION_OUTBOX_MAX_RETRY_COUNT=5
APPLICATION_OUTBOX_POLL_INTERVAL_MS=5000
APPLICATION_OUTBOX_PROCESSED_RETENTION_MS=604800000
APPLICATION_OUTBOX_PUBLISH_CONCURRENCY=5
APPLICATION_OUTBOX_PUBLISH_ENABLED=true
APPLICATION_OUTBOX_RETRY_DELAY_MS=30000
APPLICATION_OUTBOX_STALE_PROCESSING_TIMEOUT_MS=60000
REDIS_DASHBOARD_CACHE_TTL_S=120

# -------------------------------------------------------------------
# Communication service
# -------------------------------------------------------------------
COMMUNICATION_DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require
COMMUNICATION_DIRECT_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require
COMMUNICATION_GRPC_BIND_URL=0.0.0.0:50056
COMMUNICATION_GRPC_IAM_URL=iam-service:50051
COMMUNICATION_MAIL_FROM_ADDRESS=noreply@example.com
COMMUNICATION_MAIL_FROM_NAME=CareerHub
COMMUNICATION_MAIL_HOST=smtp.example.com
COMMUNICATION_MAIL_PASSWORD=<smtp-password>
COMMUNICATION_MAIL_PORT=587
COMMUNICATION_MAIL_SECURE=false
COMMUNICATION_MAIL_USER=<smtp-user>
MAIL_DELIVERY_CLAIM_TIMEOUT_MS=60000
MAIL_INTERVIEW_MAX_RETRIES=3
MAIL_OFFER_MAX_RETRIES=3
NOTIFICATION_MAX_RETRIES=3

# -------------------------------------------------------------------
# Optional self-hosted infra profile
# Only needed when using: docker compose --profile infra ...
# Override all placeholder passwords before using for real.
# -------------------------------------------------------------------
POSTGRES_USER=careerhub
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=careerhub
POSTGRES_HOST_PORT=55432

RABBITMQ_DEFAULT_USER=careerhub
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

REDIS_HOST_PORT=6379

MEILI_MASTER_KEY=change-me-meili
MEILISEARCH_HOST_PORT=7700
