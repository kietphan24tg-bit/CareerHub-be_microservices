# Base runtime environment shared by Nest services.
# Each concrete service should copy this and extend it with its own service-specific variables.

# Required
SERVICE_NAME=careerhub-gateway

# Optional with defaults
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
HTTP_LOG_ENABLED=true

# Optional shared infrastructure endpoints
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerhub
REDIS_URL=redis://localhost:6379
BROKER_URL=amqp://guest:guest@localhost:5672

# Gateway-specific transport config
GRPC_IAM_URL=0.0.0.0:50051
RABBITMQ_EXCHANGE=careerhub.events
RABBITMQ_PREFETCH=10
