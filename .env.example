# Shared reference only.
# For local development, use:
# - services/gateway/.env
# - services/iam-service/.env
# - services/candidate-service/.env
# - services/employer-service/.env
# - services/job-service/.env

# Common runtime variables
SERVICE_NAME=careerhub-service
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
HTTP_LOG_ENABLED=true

# Optional shared infrastructure endpoints
DATABASE_URL=postgresql://neondb_owner:<password>@<pooled-host>/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:<password>@<direct-host>/neondb?sslmode=require&channel_binding=require
REDIS_URL=redis://localhost:6379
BROKER_URL=amqp://guest:guest@localhost:5672

# gRPC examples
GRPC_IAM_URL=0.0.0.0:50051
GRPC_CANDIDATE_URL=127.0.0.1:50052
GRPC_EMPLOYER_URL=127.0.0.1:50053
GRPC_JOB_URL=127.0.0.1:50054

# Auth example
JWT_SECRET=careerhub-dev-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_DOMAIN=
