# Shared reference only.
# For local development, use:
# - services/gateway/.env
# - services/iam-service/.env
# - services/candidate-service/.env
# - services/employer-service/.env
# - services/job-service/.env
# - services/application-service/.env

# Common runtime variables
SERVICE_NAME=careerhub-service
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
HTTP_LOG_ENABLED=true

# Optional shared infrastructure endpoints
DATABASE_URL=postgresql://neondb_owner:<password>@<pooled-host>/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:<password>@<direct-host>/neondb?sslmode=require&channel_binding=require
REDIS_URL=redis://localhost:6379
BROKER_URL=amqps://<user>:<password>@<cloudamqp-host>/<vhost>
BROKER_PREFETCH_COUNT=10
BROKER_DURABLE=true
BROKER_DEAD_LETTER_ENABLED=true
BROKER_QUEUE_PREFIX=
BROKER_EXCHANGE_PREFIX=
BROKER_DEAD_LETTER_PREFIX=dlq

# CloudAMQP Prometheus scraping for the local observability stack
CLOUDAMQP_PROMETHEUS_URL=https://<cloudamqp-metrics-host>/metrics/detailed
CLOUDAMQP_PROMETHEUS_USERNAME=<cloudamqp-prometheus-username>
CLOUDAMQP_PROMETHEUS_PASSWORD=<cloudamqp-prometheus-password>

# gRPC examples
GRPC_IAM_URL=0.0.0.0:50051
GRPC_CANDIDATE_URL=127.0.0.1:50052
GRPC_EMPLOYER_URL=127.0.0.1:50053
GRPC_JOB_URL=127.0.0.1:50054
GRPC_APPLICATION_URL=127.0.0.1:50055

# Auth example
JWT_SECRET=careerhub-dev-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_DOMAIN=

# IAM password reset + mail examples
PASSWORD_RESET_SECRET=careerhub-password-reset-dev-secret
PASSWORD_RESET_TOKEN_TTL_MS=900000
PASSWORD_RESET_MAIL_CLAIM_TIMEOUT_MS=60000
PASSWORD_RESET_MAIL_MAX_RETRIES=3
RESET_PASSWORD_URL_BASE=http://localhost:5173/reset-password
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=dev
MAIL_PASSWORD=dev
MAIL_FROM_ADDRESS=noreply@careerhub.local
MAIL_FROM_NAME=CareerHub
