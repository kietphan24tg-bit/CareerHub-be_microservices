SERVICE_NAME=careerhub-candidate-service
PORT=3002
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
HTTP_LOG_ENABLED=true

# Candidate service uses this for Prisma runtime and migrations.
# Use the pooled Neon connection for application runtime.
DATABASE_URL=postgresql://neondb_owner:<password>@<pooled-host>/candidate_service?sslmode=require&channel_binding=require

# Use the direct Neon connection for Prisma migrations and administrative operations.
DIRECT_URL=postgresql://neondb_owner:<password>@<direct-host>/candidate_service?sslmode=require&channel_binding=require

# Candidate gRPC server bind address.
GRPC_CANDIDATE_URL=0.0.0.0:50052
