SERVICE_NAME=careerhub-candidate-service
PORT=3002
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
HTTP_LOG_ENABLED=true
LOG_FILE_PATH=../../tmp/logs/careerhub-candidate-service.jsonl
OTEL_ENABLED=true
OTEL_SERVICE_NAME=careerhub-candidate-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1

# RabbitMQ (local container).
BROKER_URL=amqp://careerhub:careerhub@127.0.0.1:5674
BROKER_QUEUE_PREFIX=
BROKER_EXCHANGE_PREFIX=careerhub.
BROKER_PREFETCH_COUNT=10
BROKER_DURABLE=true
BROKER_DEAD_LETTER_ENABLED=true
BROKER_DEAD_LETTER_PREFIX=dlq

# Postgres (local container).
DATABASE_URL=postgresql://careerhub:careerhub@127.0.0.1:55432/candidate_service?schema=public
DIRECT_URL=postgresql://careerhub:careerhub@127.0.0.1:55432/candidate_service?schema=public

# Candidate gRPC server bind address.
GRPC_CANDIDATE_URL=0.0.0.0:50052
