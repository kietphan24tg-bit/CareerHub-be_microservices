generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdentityRole {
  candidate
  employer
}

enum IdentityStatus {
  pending_profile
  active
  disabled
}

model Identity {
  id            String         @id @db.VarChar(64)
  email         String         @unique @db.VarChar(320)
  passwordHash  String         @map("password_hash")
  role          IdentityRole
  status        IdentityStatus
  acceptedTerms Boolean        @map("accepted_terms")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("identities")
}

model AuthSession {
  id           String   @id @db.VarChar(64)
  identityId   String   @map("identity_id") @db.VarChar(64)
  tokenHash    String   @unique @map("token_hash")
  rememberMe   Boolean  @map("remember_me")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([identityId])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id               String    @id @db.VarChar(64)
  identityId       String    @map("identity_id") @db.VarChar(64)
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  mailProcessingAt DateTime? @map("mail_processing_at")
  mailSentAt       DateTime? @map("mail_sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([identityId, usedAt, expiresAt])
  @@index([mailSentAt, mailProcessingAt])
  @@map("password_reset_tokens")
}

model Outbox {
  id          String   @id @db.VarChar(64)
  eventName   String   @map("event_name") @db.VarChar(255)
  payload     Json
  status      String   @db.VarChar(32)
  retryCount  Int      @default(0) @map("retry_count")
  lastError   String?  @map("last_error") @db.Text
  nextRetryAt DateTime? @map("next_retry_at")
  occurredAt  DateTime @map("occurred_at")
  processingAt DateTime? @map("processing_at")
  processedAt DateTime? @map("processed_at")

  @@index([status, occurredAt])
  @@index([status, nextRetryAt])
  @@map("outbox")
}
