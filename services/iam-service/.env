SERVICE_NAME=careerhub-iam-service
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
HTTP_LOG_ENABLED=true
LOG_FILE_PATH=../../tmp/logs/careerhub-iam-service.jsonl
OTEL_ENABLED=true
OTEL_SERVICE_NAME=careerhub-iam-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1

# RabbitMQ runtime foundation defaults.
BROKER_URL=amqps://euvgwvjp:Ix-0Wgr7Q9qkljQ7KcgykT9TxeVlWfex@fuji.lmq.cloudamqp.com/euvgwvjp
BROKER_QUEUE_PREFIX=
BROKER_EXCHANGE_PREFIX=careerhub.
BROKER_PREFETCH_COUNT=10
BROKER_DURABLE=true
BROKER_DEAD_LETTER_ENABLED=true
BROKER_DEAD_LETTER_PREFIX=dlq

# IAM service uses this for Prisma runtime and migrations.
# Use the pooled Neon connection for application runtime.
DATABASE_URL=postgresql://neondb_owner:npg_sZRTK1qkWpX2@ep-lucky-pine-aon6jvrx-pooler.c-2.ap-southeast-1.aws.neon.tech/iam_service?sslmode=require&channel_binding=require

# Use the direct Neon connection for Prisma migrations and administrative operations.
DIRECT_URL=postgresql://neondb_owner:npg_sZRTK1qkWpX2@ep-lucky-pine-aon6jvrx.c-2.ap-southeast-1.aws.neon.tech/iam_service?sslmode=require&channel_binding=require

# IAM gRPC server bind address.
GRPC_IAM_URL=0.0.0.0:50051

# JWT configuration for access and refresh tokens.
JWT_SECRET=careerhub-dev-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset token lifetime in milliseconds.
PASSWORD_RESET_SECRET=careerhub-password-reset-dev-secret
PASSWORD_RESET_TOKEN_TTL_MS=900000

# SMTP delivery for password reset emails.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=dev
MAIL_PASSWORD=dev
MAIL_SECURE=false
MAIL_FROM_ADDRESS=noreply@careerhub.local
MAIL_FROM_NAME=CareerHub
RESET_PASSWORD_URL_BASE=http://localhost:5173/reset-password
PASSWORD_RESET_MAIL_CLAIM_TIMEOUT_MS=60000
PASSWORD_RESET_MAIL_MAX_RETRIES=3
