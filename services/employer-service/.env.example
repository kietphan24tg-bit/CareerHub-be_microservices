SERVICE_NAME=careerhub-employer-service
PORT=3003
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
HTTP_LOG_ENABLED=true

# Employer service uses this for Prisma runtime and migrations.
# Use the pooled Neon connection for application runtime.
DATABASE_URL=postgresql://neondb_owner:<password>@<pooled-host>/employer_service?sslmode=require&channel_binding=require

# Use the direct Neon connection for Prisma migrations and administrative operations.
DIRECT_URL=postgresql://neondb_owner:<password>@<direct-host>/employer_service?sslmode=require&channel_binding=require

# Employer gRPC server bind address.
GRPC_EMPLOYER_URL=0.0.0.0:50053
