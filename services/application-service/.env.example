SERVICE_NAME=careerhub-application-service
PORT=3005
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
HTTP_LOG_ENABLED=true
LOG_FILE_PATH=../../tmp/logs/careerhub-application-service.jsonl
HEALTH_ENABLED=true
HEALTH_PATH=/health
HEALTH_LIVENESS_PATH=/health/live
HEALTH_READINESS_PATH=/health/ready
METRICS_ENABLED=true
METRICS_PATH=/metrics
OTEL_ENABLED=true
OTEL_SERVICE_NAME=careerhub-application-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1

# RabbitMQ runtime foundation defaults.
BROKER_URL=amqp://guest:guest@127.0.0.1:5672
BROKER_QUEUE_PREFIX=
BROKER_EXCHANGE_PREFIX=careerhub.
BROKER_PREFETCH_COUNT=10
BROKER_DURABLE=true
BROKER_DEAD_LETTER_ENABLED=true
BROKER_DEAD_LETTER_PREFIX=dlq

# Application service uses this for Prisma runtime and migrations.
# Use the pooled Neon connection for application runtime.
DATABASE_URL=postgresql://neondb_owner:<password>@<pooled-host>/application_service?sslmode=require&channel_binding=require

# Use the direct Neon connection for Prisma migrations and administrative operations.
DIRECT_URL=postgresql://neondb_owner:<password>@<direct-host>/application_service?sslmode=require&channel_binding=require

# Application gRPC server bind address.
GRPC_APPLICATION_URL=0.0.0.0:50055

# Job gRPC client address.
GRPC_JOB_URL=127.0.0.1:50054

# Outbox processor
OUTBOX_PUBLISH_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRY_COUNT=5
OUTBOX_RETRY_DELAY_MS=30000
OUTBOX_STALE_PROCESSING_TIMEOUT_MS=60000
OUTBOX_CLEANUP_ENABLED=true
OUTBOX_CLEANUP_INTERVAL_MS=60000
OUTBOX_CLEANUP_BATCH_SIZE=100
OUTBOX_PROCESSED_RETENTION_MS=604800000
OUTBOX_FAILED_RETENTION_MS=2592000000
OUTBOX_PUBLISH_CONCURRENCY=5
OUTBOX_BACKLOG_INTERVAL_MS=30000

# Redis cache (optional — để trống để tắt cache)
REDIS_URL=redis://127.0.0.1:6379
REDIS_DASHBOARD_CACHE_TTL_S=120
