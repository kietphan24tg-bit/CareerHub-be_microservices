SERVICE_NAME=careerhub-gateway
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
HTTP_LOG_ENABLED=true
LOG_FILE_PATH=../../tmp/logs/careerhub-gateway.jsonl
OTEL_ENABLED=true
OTEL_SERVICE_NAME=careerhub-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1

# RabbitMQ (local container).
BROKER_URL=amqp://careerhub:careerhub@127.0.0.1:5674
BROKER_QUEUE_PREFIX=
BROKER_EXCHANGE_PREFIX=careerhub.
BROKER_PREFETCH_COUNT=10
BROKER_DURABLE=true
BROKER_DEAD_LETTER_ENABLED=true
BROKER_DEAD_LETTER_PREFIX=dlq

# Downstream gRPC services the gateway calls.
GRPC_IAM_URL=127.0.0.1:50051
GRPC_CANDIDATE_URL=127.0.0.1:50052
GRPC_EMPLOYER_URL=127.0.0.1:50053
GRPC_JOB_URL=127.0.0.1:50054
GRPC_APPLICATION_URL=127.0.0.1:50055
GRPC_COMMUNICATION_URL=127.0.0.1:50056
GRPC_WORKFLOW_URL=127.0.0.1:50057

# Refresh token cookie configuration.
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_DOMAIN=
JWT_REFRESH_EXPIRES_IN=7d
